---
import type { LandingCopy } from '../i18n';
import { STORE_LINKS } from '../i18n';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
---

<section class="family" id="familia" aria-label="Neruz Extensions" data-section-trail="main › section#familia › p">
  <div class="family__marks" aria-hidden="true">
    <svg viewBox="0 0 128 128" class="family__svg family__svg--cyan">
      <g fill="#00e5ff" fill-rule="evenodd">
        <path d="M24 20H104L112 28V46H100V32H28V88H54V100H24L16 92V28Z" />
        <path d="M72 52H104L112 60V104L104 112H72L64 104V60ZM76 64V100H100V64Z" />
      </g>
    </svg>
    <svg viewBox="0 0 128 128" class="family__svg">
      <g fill="#ff4fd0">
        <path d="M16 76V36L36 16H80V28H40.9706L28 40.9706V76Z" />
        <path d="M16 76V36L36 16H80V28H40.9706L28 40.9706V76Z" transform="rotate(180 64 64)" />
        <path d="M64 52L76 64L64 76L52 64Z" />
      </g>
    </svg>
  </div>
  <div class="family__text">
    <p class="family__copy">{copy.privacy.familyText}</p>
    <p class="family__links">
      <a class="text-link" href={STORE_LINKS.pageView} rel="noopener">{copy.privacy.familyLink}</a>
      <a class="text-link" href={STORE_LINKS.github} rel="noopener">Neruz Inspect · GitHub</a>
    </p>
  </div>
</section>
