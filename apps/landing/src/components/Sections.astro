---
import { TOOL_GROUP } from '../demo/layout';
import { SCENES, sceneTools, TOOL_TARGET } from '../demo/scenes';
import type { LandingCopy } from '../i18n';
import Dock from './stage/Dock.astro';
import Panel from './stage/Panel.astro';
import ReportSheet from './stage/ReportSheet.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const { sections, groups } = copy;
const remSample = new Intl.NumberFormat(copy.htmlLang).format(1.5);
const GROUP_ICONS = ['cor', 'tipo', 'layout', 'codigo', 'mov', 'tech', 'pagina', 'utils'];
const scenes = sections.flatMap((section) => {
  const spec = SCENES[section.id];
  if (!spec) return [];
  const sectionGroup = Number(section.layers[0]) - 1;
  const chips = section.tools.map((name, index) => {
    const tool = spec.chipTools[index] ?? null;
    const group = tool ? TOOL_GROUP[tool] : sectionGroup;
    return { name, tool, icon: GROUP_ICONS[group] };
  });
  return [{ section, spec, chips, tools: sceneTools(spec), group: TOOL_GROUP[spec.tool] }];
});
---

<div class="layers" data-scenes>
  {
    scenes.map(({ section, spec, chips, tools, group }) => (
      <section
        class={`layer-section layer-section--${section.id}`}
        id={section.id}
        aria-labelledby={`${section.id}-title`}
        data-scene={section.id}
        data-section-trail={`main › section#${section.id} › h2`}
      >
        <div class="layer-section__text">
          <p class="layer-tag">
            {section.layers.map((number, tagIndex) => (
              <span>
                <b>{number}</b> {groups[Number(number) - 1]?.name}
                {tagIndex < section.layers.length - 1 && <i aria-hidden="true"> · </i>}
              </span>
            ))}
          </p>
          <h2 id={`${section.id}-title`} class="layer-section__title">
            {section.title}
          </h2>
          <p class="layer-section__body">{section.text}</p>
          <ul class="np tool-chips">
            {chips.map((chip) => (
              <li>
                {chip.tool ? (
                  <button
                    type="button"
                    class="ni-filter__chip tool-chip"
                    data-scene-tool={chip.tool}
                    aria-pressed={chip.tool === spec.tool ? 'true' : 'false'}
                  >
                    <svg class="i" aria-hidden="true">
                      <use href={`#nis-${chip.icon}`} />
                    </svg>
                    {chip.name}
                  </button>
                ) : (
                  <span class="ni-filter__chip tool-chip tool-chip--static">
                    <svg class="i" aria-hidden="true">
                      <use href={`#nis-${chip.icon}`} />
                    </svg>
                    {chip.name}
                  </span>
                )}
              </li>
            ))}
          </ul>
          {section.id === 'utilitarios' && (
            <div class="converter">
              <label>
                <span class="visually-hidden">px</span>
                <input type="number" value="24" min="0" max="9999" inputmode="numeric" data-px />
              </label>
              <span class="converter__unit">px</span>
              <span aria-hidden="true">=</span>
              <output class="converter__out" data-rem>
                {remSample}
              </output>
              <span class="converter__unit">rem</span>
            </div>
          )}
          {section.note && <p class="layer-section__note">{section.note}</p>}
        </div>
        <div class="layer-section__stage np" data-scene-sheet aria-hidden="true">
          <Panel copy={copy} tools={tools} target={TOOL_TARGET[spec.tool]} variant="sheet" />
          {section.id === 'pagina' && <ReportSheet copy={copy} class="layer-section__report" />}
          <Dock copy={copy} variant="mini" open={group} class="layer-section__dock" />
        </div>
      </section>
    ))
  }
</div>
