---
import { DEMO_RECTS, DEMO_SWATCHES, placeRect } from '../demo/layout';
import type { LandingCopy } from '../i18n';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const { demo } = copy;
---

<div class="demo" data-inspect="paper">
  <div class="demo__nav" style={placeRect(DEMO_RECTS.nav)} data-inspect="nav"></div>
  <p class="demo__brand" style={placeRect(DEMO_RECTS.brand)} data-inspect="brand">Maré</p>
  <ul class="demo__links" style={placeRect(DEMO_RECTS.links)} data-inspect="links">
    {demo.nav.map((item) => <li>{item}</li>)}
  </ul>
  <p class="demo__title" style={placeRect(DEMO_RECTS.title)} data-inspect="title">{demo.title}</p>
  <p class="demo__text" style={placeRect(DEMO_RECTS.text)} data-inspect="text">{demo.text}</p>
  <p class="demo__button" style={placeRect(DEMO_RECTS.button)} data-inspect="button">{demo.button}</p>
  {
    DEMO_SWATCHES.map((swatch) => (
      <span
        class={`demo__chip demo__chip--${swatch.key}`}
        style={placeRect(swatch.rect)}
        data-inspect={`swatch-${swatch.key}`}
      />
    ))
  }
  <p class="demo__marquee" style={placeRect(DEMO_RECTS.marquee)} data-inspect="marquee">
    <span>{demo.marquee}</span>
  </p>
  <div class="demo__art" style={placeRect(DEMO_RECTS.art)} data-inspect="art">
    <svg viewBox="0 0 292 440" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="292" height="440" fill="#DDE3D0"></rect>
      <ellipse cx="146" cy="392" rx="96" ry="14" fill="#1C2620" opacity=".14"></ellipse>
      <path d="M118 96h56v34c44 22 64 62 64 112 0 56-34 100-92 100s-92-44-92-100c0-50 20-90 64-112Z" fill="#B4582F"></path>
      <path d="M96 252c28 14 72 14 100 0" fill="none" stroke="#EEF0E6" stroke-width="4"></path>
      <circle cx="146" cy="300" r="26" fill="#6F8A5B"></circle>
    </svg>
  </div>
</div>
