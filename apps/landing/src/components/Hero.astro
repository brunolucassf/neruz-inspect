---
import type { LandingCopy } from '../i18n';
import { IS_STORE_LIVE, STORE_LINKS } from '../i18n';
import StoreButton from './StoreButton.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const { hero } = copy;
---

<section class="hero" data-hero aria-labelledby="hero-title" data-section-trail="main › section#hero › h1">
  <div class="hero__copy">
    <p class="eyebrow hero__eyebrow">NERUZ / INSPECT</p>
    <h1 id="hero-title" class="hero__title">{hero.title}</h1>
    <p class="hero__sub">{hero.subtitle}</p>
    <ul class="hero__micro">
      {hero.micro.map((item) => <li>{item}</li>)}
    </ul>
    <div class="hero__cta" data-hero-cta>
      <StoreButton copy={copy} withMeta />
      {IS_STORE_LIVE && <a class="btn btn--lg btn--ghost" href={STORE_LINKS.github} rel="noopener" data-wire><span>{copy.cta.viewOnGithub}</span></a>}
    </div>
  </div>
</section>
