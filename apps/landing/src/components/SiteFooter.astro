---
import type { LandingCopy } from '../i18n';
import { FONTE_DEV_CREDIT, FONTE_DEV_URL, STORE_LINKS } from '../i18n';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  copy: LandingCopy;
  kind?: 'home' | 'privacy';
}

const { copy, kind = 'home' } = Astro.props;
const { footer } = copy;
const links = [
  { href: copy.privacyPath, label: footer.privacy, external: false },
  { href: STORE_LINKS.github, label: footer.github, external: true },
  { href: STORE_LINKS.license, label: footer.license, external: true },
  { href: STORE_LINKS.pageView, label: footer.family, external: true },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <a class="brand brand--horizontal" href={copy.path} aria-label="Neruz Inspect">
      <img src="/brand/neruz-inspect-horizontal.svg" width="180" height="48" alt="" loading="lazy" />
    </a>
    <nav class="site-footer__nav" aria-label={footer.navLabel}>
      <ul>
        {links.map((link) => <li><a href={link.href} rel={link.external ? 'noopener' : undefined}>{link.label}</a></li>)}
        <li><button type="button" class="site-footer__consent" data-consent-open>{copy.consent.preferences}</button></li>
      </ul>
    </nav>
    <LanguageMenu copy={copy} opensUp kind={kind} />
  </div>
  <p class="site-footer__credit">
    <a href={FONTE_DEV_URL} target="_blank" rel="noopener">
      <img src="/fonte-dev_icone_fundo-escuro.svg" width="20" height="18" alt="" loading="lazy" />
      <span>{FONTE_DEV_CREDIT}</span>
    </a>
  </p>
</footer>
