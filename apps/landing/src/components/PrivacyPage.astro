---
import type { LandingCopy } from '../i18n';
import Base from '../layouts/Base.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const page = copy.privacyPage;
---

<Base copy={copy} kind="privacy" title={page.title} description={page.description}>
  <SiteHeader copy={copy} showStore={false} kind="privacy" />
  <main id="conteudo" tabindex="-1" class="legal">
    <p class="eyebrow">NERUZ / INSPECT</p>
    <h1 class="legal__title">{page.heading}</h1>
    <p class="legal__updated">{page.updated}</p>
    {
      page.blocks.map((block) => (
        <section class="legal__block">
          <h2>{block.title}</h2>
          {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {block.items && <ul>{block.items.map((item) => <li>{item}</li>)}</ul>}
        </section>
      ))
    }
    <p><a class="text-link" href={copy.path}>{page.back}</a></p>
  </main>
  <SiteFooter copy={copy} kind="privacy" />
</Base>

<script>
  import '../scripts/legal';
</script>
