---
import type { LandingCopy } from '../i18n';
import Dock from './stage/Dock.astro';
import ExplodeLayers from './stage/ExplodeLayers.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const { explode, groups } = copy;
const GROUP_ICONS = ['cor', 'tipo', 'layout', 'codigo', 'mov', 'tech', 'pagina', 'utils'];
const targets = [
  'cor',
  'cor',
  'layout',
  'design-system',
  'movimento',
  'tecnologia',
  'pagina',
  'utilitarios',
];
const CORE_LAYERS = [0, 1, 2, 6];
---

<section class="explode" id="camadas" data-explode aria-labelledby="explode-title" data-section-trail="main › section#camadas › h2">
  <div class="explode__pin" data-explode-pin>
    <header class="explode__head">
      <p class="eyebrow">{explode.eyebrow}</p>
      <h2 id="explode-title" class="explode__title">{explode.title}</h2>
      <p class="explode__sub">{explode.subtitle}</p>
    </header>

    <ol class="explode__index" aria-label={explode.indexLabel} data-explode-index>
      {
        groups.map((group, index) => (
          <li class:list={{ 'is-core': CORE_LAYERS.includes(index) }} data-explode-label={index}>
            <a href={`#${targets[index]}`}>
              <b class="explode__num">{String(index + 1).padStart(2, '0')}</b>
              <svg class="explode__icon" aria-hidden="true">
                <use href={`#nis-${GROUP_ICONS[index]}`} />
              </svg>
              <span>{group.name}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="explode__mini-track" data-explode-mini-track>
      <div class="explode__mini np" data-explode-mini aria-hidden="true">
        <div class="explode__mini-scene">
          <ExplodeLayers copy={copy} variant="mini" />
        </div>
        <Dock copy={copy} variant="mini" open={0} class="explode__mini-dock" />
      </div>
    </div>
  </div>
</section>
