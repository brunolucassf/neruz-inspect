---
import type { LandingCopy } from '../i18n';
import Base from '../layouts/Base.astro';
import Family from './Family.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import Journey from './Journey.astro';
import MobileCta from './MobileCta.astro';
import PrivacySection from './PrivacySection.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
---

<Base copy={copy}>
  <SiteHeader copy={copy} />
  <main id="conteudo" tabindex="-1">
    <Journey copy={copy} />
    <PrivacySection copy={copy} />
    <Family copy={copy} />
    <Faq copy={copy} />
    <FinalCta copy={copy} />
  </main>
  <SiteFooter copy={copy} />
  <div class="dom-trail" data-dom-trail aria-hidden="true" hidden>
    <span data-trail-path>main</span>
    <span data-trail-coords>x 0 · y 0</span>
  </div>
  <MobileCta copy={copy} />
</Base>

<script>
  import '../scripts/main';
</script>
