---
import type { LandingCopy } from '../i18n';
import { STORE_LINKS } from '../i18n';
import LanguageMenu from './LanguageMenu.astro';
import StoreButton from './StoreButton.astro';

interface Props {
  copy: LandingCopy;
  showStore?: boolean;
  kind?: 'home' | 'privacy';
}

const { copy, showStore = true, kind = 'home' } = Astro.props;
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="brand" href={copy.path} aria-label="Neruz Inspect">
      <img src="/favicon.svg" width="32" height="32" alt="" />
      <span class="brand__name">NERUZ <span aria-hidden="true">/</span> INSPECT</span>
    </a>
    <nav class="site-header__nav" aria-label={copy.header.navLabel}>
      <a class="text-link site-header__github" href={STORE_LINKS.github} rel="noopener">{copy.header.github}</a>
      <LanguageMenu copy={copy} kind={kind} />
      {showStore && <div class="site-header__cta"><StoreButton copy={copy} compact /></div>}
    </nav>
  </div>
</header>
