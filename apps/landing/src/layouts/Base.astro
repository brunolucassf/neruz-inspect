---
import '@neruz/ui/tokens.css';
import '../styles/product.css';
import '../styles/base.css';
import '../styles/theme.css';
import '../styles/landing.css';
import type { LandingCopy } from '../i18n';
import { DICTIONARIES, SITE_URL } from '../i18n';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  copy: LandingCopy;
  kind?: 'home' | 'privacy';
  title?: string;
  description?: string;
}

const { copy, kind = 'home' } = Astro.props;
const title = Astro.props.title ?? copy.meta.title;
const description = Astro.props.description ?? copy.meta.description;
const ogDescription = kind === 'home' ? copy.meta.ogDescription : description;
const pathOf = (item: LandingCopy) => (kind === 'home' ? item.path : item.privacyPath);
const alternates = Object.values(DICTIONARIES);
const canonical = `${SITE_URL}${pathOf(copy)}`;
const ogLocales: Record<string, string> = { 'pt-BR': 'pt_BR', en: 'en_US', es: 'es_419' };
---

<!doctype html>
<html lang={copy.htmlLang} data-locale={copy.locale} data-product="inspect">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080D14" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.htmlLang} href={`${SITE_URL}${pathOf(alt)}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${pathOf(DICTIONARIES['pt-BR'])}`} />
    <meta property="og:site_name" content="Neruz Inspect" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[copy.locale]} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/Sora-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const connection = navigator.connection;
        const isSaveData = Boolean(connection && connection.saveData);
        root.classList.add('has-js');
        if (prefersReducedMotion) {
          root.classList.add('is-static');
          return;
        }
        root.classList.add('is-motion');
        if (isSaveData) root.classList.add('is-lite');
        let hasSeenIntro = false;
        try {
          hasSeenIntro = sessionStorage.getItem('ni-intro') === '1';
        } catch {}
        if (!hasSeenIntro) root.classList.add('is-intro');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{copy.skipLink}</a>
    <ConsentBanner copy={copy} />
    <slot />
    <script>
      import '../scripts/consent';
    </script>
  </body>
</html>
